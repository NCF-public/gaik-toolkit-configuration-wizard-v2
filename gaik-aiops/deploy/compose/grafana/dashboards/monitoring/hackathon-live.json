   "id": 10
  },
  {
   "type": "timeseries",
   "title": "Agent failures per 10 min by kind",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (kind) (increase(wizard_agent_errors_total{service_name=\"wizard-v2-api\"}[10m]))",
     "legendFormat": "{{kind}}"
    }
   ],
   "id": 11
  },
  {
   "type": "timeseries",
   "title": "Turn length p95 and first reply p95",
   "datasource": {
    "type": "prometheus",
