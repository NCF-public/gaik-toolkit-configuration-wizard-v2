    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(wizard_agents_limit{service_name=\"wizard-v2-api\"})",
     "legendFormat": "limit"
    }
   ],
   "id": 9
  },
  {
   "type": "timeseries",
