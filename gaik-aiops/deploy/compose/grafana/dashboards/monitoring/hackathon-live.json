{
 "uid": "gaik-hackathon-live",
 "title": "Hackathon live",
 "description": "Event view: how many are in, whether capacity holds, how far teams get. Set the time range to the event.",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "wizard"
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "type": "stat",
   "title": "Active sessions (15 min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(wizard_sessions{service_name=\"wizard-v2-api\", state=\"active\"})",
     "legendFormat": ""
    }
   ],
   "id": 1
  },
  {
   "type": "gauge",
   "title": "Live agents of the limit",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(wizard_agents_live{service_name=\"wizard-v2-api\"} / wizard_agents_limit{service_name=\"wizard-v2-api\"})"
    }
   ],
   "id": 2
  },
  {
   "type": "stat",
   "title": "Chat turns running",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(wizard_turns_running{service_name=\"wizard-v2-api\"})",
     "legendFormat": ""
    }
   ],
   "id": 3
  },
  {
   "type": "gauge",
   "title": "Sandbox runs of the limit",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(wizard_sandbox_runs_active{service_name=\"wizard-v2-api\"} / wizard_sandbox_runs_limit{service_name=\"wizard-v2-api\"})"
    }
   ],
   "id": 4
  },
  {
   "type": "stat",
   "title": "Refused in 10 min",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(wizard_refusals_total{service_name=\"wizard-v2-api\", code=~\"agent_capacity|agent_busy|chat_rate_limited|sandbox_busy|busy\"}[10m])) or vector(0)",
     "legendFormat": ""
    }
   ],
   "id": 5
  },
  {
   "type": "stat",
   "title": "First reply p95 (15 min)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 10
       },
       {
        "color": "red",
        "value": 30
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(wizard_turn_first_frame_seconds_bucket{service_name=\"wizard-v2-api\"}[15m])))",
     "legendFormat": ""
    }
   ],
   "id": 6
  },
  {
   "type": "bargauge",
   "title": "Progress since the start of the view",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum((wizard_sessions_created_total{service_name=\"wizard-v2-api\"} - wizard_sessions_created_total{service_name=\"wizard-v2-api\"} offset $__range) or wizard_sessions_created_total{service_name=\"wizard-v2-api\"})",
     "legendFormat": "sessions started"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(wizard_gates_total{service_name=\"wizard-v2-api\", gate=\"gate_1\", to=\"approved\"}[$__range]))",
     "legendFormat": "requirements approved"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(wizard_gates_total{service_name=\"wizard-v2-api\", gate=\"gate_2\", to=\"approved\"}[$__range]))",
     "legendFormat": "solution approved"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(wizard_sandbox_runs_total{service_name=\"wizard-v2-api\", kind=\"run\", phase=\"succeeded\"}[$__range]))",
     "legendFormat": "successful PoC runs"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(wizard_gates_total{service_name=\"wizard-v2-api\", gate=\"gate_3\", to=\"approved\"}[$__range]))",
     "legendFormat": "PoC approved"
    },
    {
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(wizard_gates_total{service_name=\"wizard-v2-api\", gate=\"gate_4\", to=\"approved\"}[$__range]))",
     "legendFormat": "documented"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "displayMode": "basic"
   },
   "id": 7
  },
  {
   "type": "bargauge",
   "title": "Components in approved solutions",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sort_desc(sum by (component) (increase(wizard_components_selected_total{service_name=\"wizard-v2-api\"}[$__range])))",
     "legendFormat": "{{component}}"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "displayMode": "basic"
   },
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "Live agents and limit",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(wizard_agents_live{service_name=\"wizard-v2-api\"})",
