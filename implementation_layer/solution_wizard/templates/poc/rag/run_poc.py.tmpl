"""Proof of Concept: ${use_case_name}

Generated by GAIK Solution Configuration Wizard V2.
Pattern: rag (RAGWorkflow module)

Usage:
    python run_poc.py                          # interactive Q&A after indexing
    python run_poc.py --synthetic              # generate synthetic docs + index
    python run_poc.py --query "your question"  # single-question mode

Without a terminal (the wizard's test run, a case, a pipe) nobody can type a
question. The run then answers the questions in the text files of sample_input/
(.txt or .md, one question per line), else the lines piped to it.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

import yaml
from dotenv import load_dotenv

# Only the PoC's own .env, never one from a parent folder.
load_dotenv(Path(__file__).parent / ".env")

from gaik.software_modules.RAG_workflow import RAGWorkflow  # noqa: E402
sys.path.insert(0, str(Path(__file__).parent))
from input_bundle import uploaded_names  # noqa: E402
from provider_config import get_stage_config  # noqa: E402

#: Text files in sample_input/ hold the questions of a run that has no terminal.
QUESTION_SUFFIXES = (".txt", ".md")
#: More lines than this is a document, not a list of questions: every line would
#: be one model call.
MAX_QUESTIONS = 20


def load_config() -> dict:
    config_path = Path(__file__).parent / "config.yaml"
    with open(config_path) as f:
        return yaml.safe_load(f)


def find_documents(config: dict) -> list:
    sample_dir = Path(__file__).parent / config.get("paths", {}).get("sample_input", "sample_input")
    # RAGWorkflow uses VisionRagParser which expects PDF files.
    # Subfolders too: a case's documents often sit in documents/ under the bundle (#255).
    docs = [f for f in sample_dir.rglob("*") if f.is_file() and f.suffix.lower() == ".pdf"]
    return sorted(docs)


def find_questions(sample_dir: Path) -> list:
    """The questions given as files: every non-empty line of the text files in sample_input/.

    The wizard's test run and a case run have no terminal, so the question comes
    as a text file beside the documents. A text file the user added themselves
    is read instead of the package's sample questions.
    """
    root = sample_dir.resolve()
    files = sorted(
        f for f in sample_dir.rglob("*") if f.is_file() and f.suffix.lower() in QUESTION_SUFFIXES
    )
    own = uploaded_names(sample_dir)
    mine = [f for f in files if f.name in own and f.parent.resolve() == root]
    questions = []
    for f in mine or files:
        lines = f.read_text(encoding="utf-8-sig", errors="replace").splitlines()
        questions.extend(line.strip() for line in lines if line.strip())
        if len(questions) > MAX_QUESTIONS:
            print(
                f"ERROR: {f.relative_to(sample_dir)} brings the questions to more than "
                f"{MAX_QUESTIONS}. A text file here is read as questions, one per line; "
                "the documents to search must be PDF files.",
                file=sys.stderr,
            )
            sys.exit(1)
    return questions


def generate_synthetic_docs(sample_dir: Path) -> list:
    """Generate minimal synthetic PDF documents for testing.

    RAGWorkflow uses VisionRagParser which requires PDF files.
    Tries reportlab; if unavailable, prints a clear message and exits -- .txt
    files are not accepted by the parser and would silently produce no chunks.
    """
    sample_dir.mkdir(parents=True, exist_ok=True)
    samples = [
        ("doc1.pdf", [
            "SYNTHETIC DOCUMENT 1",
            "Use case: ${use_case_name}",
            "Replace with real PDF documents for meaningful retrieval results.",
        ]),
        ("doc2.pdf", [
            "SYNTHETIC DOCUMENT 2",
            "The RAG workflow indexes all PDF files in sample_input/.",
        ]),
    ]
    try:
        from reportlab.lib.pagesizes import A4
        from reportlab.pdfgen import canvas as rl_canvas

        paths = []
        for name, lines in samples:
            p = sample_dir / name
            c = rl_canvas.Canvas(str(p), pagesize=A4)
            y = 750
            for line in lines:
                c.drawString(50, y, line)
                y -= 20
            c.save()
            paths.append(p)
        print(f"Generated {len(paths)} synthetic PDF(s) in {sample_dir}")
        print("NOTE: Replace with real PDFs for meaningful retrieval results.")
        return paths
    except ImportError:
        print(
            "ERROR: reportlab is not installed -- synthetic PDF generation requires it.\n"
            "Install it with: pip install reportlab\n"
            "Or place real .pdf files in sample_input/ and re-run without --synthetic.",
            file=__import__("sys").stderr,
        )
        __import__("sys").exit(1)


def main() -> None:
    parser = argparse.ArgumentParser(description="${use_case_name} PoC")
    parser.add_argument("--synthetic", action="store_true", help="Generate synthetic sample documents")
    parser.add_argument("--query", help="Run a single question and exit")
    args = parser.parse_args()

    config = load_config()
    sample_dir = Path(__file__).parent / config.get("paths", {}).get("sample_input", "sample_input")
    sample_dir.mkdir(parents=True, exist_ok=True)
    output_dir = Path(__file__).parent / config.get("paths", {}).get("output", "output")
    output_dir.mkdir(parents=True, exist_ok=True)

    if args.synthetic:
        documents = generate_synthetic_docs(sample_dir)
    else:
        documents = find_documents(config)
        if not documents:
            print(f"ERROR: No documents found in {sample_dir}", file=sys.stderr)
            print("Place .pdf files there, or use --synthetic.")
            sys.exit(1)

    # Without a terminal nobody can type a question. Waiting for one ended the run
    # at once with exit code 0 and an empty output/, which read as a success.
    questions = None
    if not args.query and not (sys.stdin and sys.stdin.isatty()):
        questions = find_questions(sample_dir)
        if not questions and sys.stdin:
            questions = [line.strip() for line in sys.stdin if line.strip()]
        if not questions:
            print(
                "ERROR: No question to answer. This run has no terminal to type one in: "
                f"add a text file (.txt) with one question per line to {sample_dir.name}/, "
                "or run with --query.",
                file=sys.stderr,
            )
            sys.exit(1)

    persist_path = str(Path(__file__).parent / "output" / "chroma_store")
    workflow = RAGWorkflow(
        parser_config=get_stage_config(config, "parser"),
        embedding_config=get_stage_config(config, "embedding"),
        answer_config=get_stage_config(config, "answer"),
        persist=True,
        persist_path=persist_path,
        citations=True,
        stream=False,
        conversation_history=False,
    )

    print(f"Indexing {len(documents)} document(s)...")
    workflow.index_documents(documents)
    print("Index ready.")

    _pdf_source = None

    if args.query:
        result = workflow.ask(args.query, stream=False)
        answer = getattr(result, "answer", str(result))
        print(f"\nQ: {args.query}")
        print(f"A: {answer}")
        output_path = output_dir / "query_result.json"
        output_path.write_text(
            json.dumps({"query": args.query, "answer": answer}, indent=2, ensure_ascii=False),
            encoding="utf-8",
        )
        print(f"\nResult saved to: {output_path}")
        _pdf_source = {"query": args.query, "answer": answer}
    else:
        session_results = []

        def ask(query: str) -> None:
            result = workflow.ask(query, stream=False)
            answer = getattr(result, "answer", str(result))
            print(f"\nAnswer: {answer}")
            session_results.append({"query": query, "answer": answer})

        if questions is not None:
            print(f"\nNo terminal: answering {len(questions)} question(s) given as input.")
            for query in questions:
                print(f"\nQuestion: {query}")
                ask(query)
        else:
            # Interactive mode
            print("\nReady. Type your question (or 'exit' to quit).")
            while True:
                try:
                    query = input("\nQuestion: ").strip()
                except (EOFError, KeyboardInterrupt):
                    break
                if query.lower() in ("exit", "quit", "q"):
                    break
                if not query:
                    continue
                ask(query)

        if session_results:
            output_path = output_dir / "session_results.json"
            output_path.write_text(
                json.dumps(session_results, indent=2, ensure_ascii=False),
                encoding="utf-8",
            )
            print(f"\nSession saved to: {output_path}")
            _pdf_source = session_results

${pdf_report_section}

if __name__ == "__main__":
    main()
