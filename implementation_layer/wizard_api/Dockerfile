FROM python:3.11-slim AS base

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip

COPY wizard_api/pyproject.toml ./
COPY wizard_api/wizard_api ./wizard_api
COPY wizard_api/alembic ./alembic
COPY wizard_api/alembic.ini ./
COPY wizard_api/tests ./tests

# solution_wizard provides BPMN generation (V2 adapter + bpmn_generator).
# Its pyproject.toml landed in #148, so it installs editable; the editable
# install keeps its registries/templates data files resolvable from the source
# tree at runtime.
# The sandbox Job manifest the runner submits (#91). Copied in rather than
# located by path arithmetic from the module — that assumption is what broke in
# #180, and the layout here is not the checkout's.
COPY deploy/openshift/sandbox-job.yaml /manifests/sandbox-job.yaml

COPY solution_wizard /solution_wizard
RUN pip install --no-cache-dir -e /solution_wizard

# The wizard agent runs solution_wizard's scripts through its Bash tool, and
# Phase 4's generate_schema.py calls GAIK's SchemaGenerator (gaik[extract]).
# Without the package the agent reports "gaik is not installed", the session
# never gets an output_schema.py, and no PoC package can be scaffolded — on
# every instance, since the image is the same. Pinned to the toolkit version
# the runner image executes against (deploy/poc-runner/Dockerfile), so the
# schema is generated by the same gaik the PoC later runs on.
# The same extras as the runner image (deploy/poc-runner/Dockerfile), not only
# extract: the agent writes run_poc.py against VisionExtractor, LLMJudge,
# ReportWriter and the rest, and with only gaik[extract] it could not import
# them to check a call before the user's first run (#256). The two lists are
# kept equal by a test (test_deploy_instances).
ARG GAIK_VERSION=0.8.2
ARG GAIK_EXTRAS="extract,transcriber,enhance-transcript,audio-to-structured-data,llm-judge,vision-extract,multimodal-parser,documents-to-structured-data-cpu,evaluators,report-writer,vector-store"
# pandas: the package check parses an entrypoint's imports and looks them up in this
# image, because it holds the same packages as the runner. Without pandas here a PoC
# that imports it is held back as "not ready" although the runner has it.
RUN pip install --no-cache-dir "gaik[${GAIK_EXTRAS}]==${GAIK_VERSION}" "pandas>=2.0"


# [sandbox] brings the Kubernetes client the SandboxRunner needs to create and
# follow Jobs. Without it the image starts fine and every sandbox run then fails
# with "the kubernetes client is not installed".
RUN pip install --no-cache-dir -e ".[sandbox]"
# Fail the build, not the agent's turn, if a component the agent designs with
# cannot be imported here. Same list as the runner's smoke test.
RUN python - <<'PY'
import importlib

for module in (
    "gaik.software_modules.audio_to_structured_data",
    "gaik.software_modules.documents_to_structured_data",
    "gaik.software_modules.report_writer",
    "gaik.software_components.extractor",
    "gaik.software_components.vision_extractor",
    "gaik.software_components.parsers.multimodal_parser",
    "gaik.software_components.transcriber",
    "gaik.software_components.validators",
    # vector-store: gaik imports chromadb inside VectorStore.__init__, at the first
    # call, so only an explicit import here catches a runner without it (#268).
    "chromadb",
    "yaml",
    "pandas",
    "pydantic",
    "dotenv",
):
    importlib.import_module(module)
print("import smoke test ok")
PY

ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
ENV WIZARD_SESSION_OUTPUT_ROOT=/data/sessions

EXPOSE 8100

FROM base AS dev

RUN pip install --no-cache-dir -e ".[dev]"

CMD ["sh", "-c", "alembic upgrade head && uvicorn wizard_api.main:app --host 0.0.0.0 --port 8100"]

FROM base AS production

CMD ["sh", "-c", "alembic upgrade head && uvicorn wizard_api.main:app --host 0.0.0.0 --port 8100"]
