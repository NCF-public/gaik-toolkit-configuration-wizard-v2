# Wizard API — copy to .env for local dev outside Docker

WIZARD_DATABASE_URL=postgresql+psycopg://wizard:wizard@localhost:5432/wizard
WIZARD_SESSION_OUTPUT_ROOT=/tmp/wizard-sessions

# Shared service secret between wizard_v2_web and wizard_api (#132).
# Leave UNSET for local dev — service auth is then off and the API is open to
# anything that can reach it, which is fine on localhost.
#
# In ANY deployed environment this MUST be set, to the SAME value on both the
# web and the api pod. Until it is set, the API accepts unauthenticated calls
# from anything in the cluster and logs a warning at startup.
# WIZARD_API_TOKEN=

# Ownership (#134): when set to 1, every call must carry X-Wizard-User-Id.
# Leave unset until the sandbox Job and the E2E helpers send the header too;
# a mismatching header is refused regardless of this flag.
# WIZARD_REQUIRE_USER_HEADER=1

# What one session's cases may hold. Every session shares the api's volume, so
# size these to it: the defaults are 100 cases and 1024 MB of case input.
# WIZARD_MAX_CASES_PER_SESSION=100
# WIZARD_MAX_SESSION_INPUT_MB=1024

# Wizard agents and chat (see README "Agent and chat limits"). Each live chat
# session holds an agent process in the api pod. Over their own cap a user gets
# 429 agent_busy; no other user's agent is ended for them. The chat turn rate is
# per user per minute; 0 turns it off.
# WIZARD_MAX_LIVE_AGENTS=20
# WIZARD_MAX_LIVE_AGENTS_PER_USER=2
# WIZARD_MAX_CHAT_TURNS_PER_MINUTE=0

# WP5 AIOps (wizard_api.telemetry): send spans (turns, gates, sandbox runs, tokens
# and cost) to the collector. Unset, nothing is sent. Locally that is the
# gaik-aiops compose stack; run the API on the host so 127.0.0.1 reaches it.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=wizard-v2-api
