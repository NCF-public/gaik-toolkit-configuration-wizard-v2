# Example secrets — copy to secrets.yaml, fill in real values, then:
#   oc apply -f secrets.yaml -n <project>
# DO NOT commit secrets.yaml (it is gitignored). Only this .example is tracked.
#
# NEXT_PUBLIC_* frontend vars are NOT secrets and NOT set here — they are baked
# into the web image at build time via deploy.sh --build-arg.

apiVersion: v1
kind: List
items:
  # Postgres credentials for wizard-v2-db. Keep database-url consistent with
  # database-user/-password/-name (host = service name wizard-v2-db). Apply this
  # BEFORE postgres.yaml — the DB pod and the api both read from this Secret.
  - apiVersion: v1
    kind: Secret
    metadata:
      name: wizard-v2-db
    type: Opaque
    stringData:
      database-user: wizard
      database-password: "generate-a-strong-password"
      database-name: wizard_v2
      database-url: "postgresql+psycopg://wizard:generate-a-strong-password@wizard-v2-db:5432/wizard_v2"

  # Live-agent auth for wizard-v2-api (Claude Agent SDK → Azure Foundry).
  - apiVersion: v1
    kind: Secret
    metadata:
      name: wizard-v2-api-keys
    type: Opaque
    stringData:
      CLAUDE_CODE_USE_FOUNDRY: "1"
      ANTHROPIC_FOUNDRY_API_KEY: "your-foundry-api-key"
      ANTHROPIC_FOUNDRY_RESOURCE: "haagahelia-poc-gaik"
      ANTHROPIC_DEFAULT_SONNET_MODEL: "claude-sonnet-4-6"

  # Server-side runtime secret for wizard-v2-web.
  - apiVersion: v1
    kind: Secret
    metadata:
      name: wizard-v2-web
    type: Opaque
    stringData:
      # Any stable 32-byte base64 string; keep it constant across redeploys.
      # Generate: openssl rand -base64 32
      NEXT_SERVER_ACTIONS_ENCRYPTION_KEY: "generate-with-openssl-rand-base64-32"

  # Shared service token (#135). The SAME value is read by wizard-v2-api
  # (validates the X-Wizard-Service-Token header) and wizard-v2-web (sends it
  # on every server-side call). Every endpoint except /health requires it.
  # Generate: openssl rand -hex 32
  - apiVersion: v1
    kind: Secret
    metadata:
      name: wizard-v2-token
    type: Opaque
    stringData:
      WIZARD_API_TOKEN: "generate-with-openssl-rand-hex-32"
