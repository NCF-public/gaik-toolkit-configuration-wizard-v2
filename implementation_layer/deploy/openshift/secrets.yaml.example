# Example secrets — copy to secrets.yaml, fill in real values, then:
#   PROJECT=<project> [INSTANCE=<name>] ./deploy.sh secrets
# DO NOT commit secrets.yaml (it is gitignored). Only this .example is tracked.
#
# Keep NAME_PLACEHOLDER as it is: deploy.sh substitutes the instance prefix
# (wizard-v2 for the staging stack, wizard-v2-<instance> for a second stack in
# the same project), so one filled-in copy serves every instance. Generate a
# different password and token per instance all the same.
#
# NEXT_PUBLIC_* frontend vars are NOT secrets and NOT set here — they are baked
# into the web image at build time via deploy.sh --build-arg.
#
# Model-provider keys (Claude Agent SDK via Azure Foundry, Azure OpenAI for the
# sandbox) are NOT here either: deployment-api.yaml and sandbox-job.yaml read
# the project-wide Secret `gaik-demo-api-keys`, which is shared with the demo
# app and with every instance. Do not redefine it from this file — `oc apply`
# would replace the keys the other consumers rely on.

apiVersion: v1
kind: List
items:
  # Postgres credentials for NAME_PLACEHOLDER-db. Keep database-url consistent
  # with database-user/-password/-name (host = service name NAME_PLACEHOLDER-db).
  # Apply this BEFORE postgres.yaml — the DB pod and the api both read from
  # this Secret.
  - apiVersion: v1
    kind: Secret
    metadata:
      name: NAME_PLACEHOLDER-db
    type: Opaque
    stringData:
      database-user: wizard
      database-password: "generate-a-strong-password"
      database-name: wizard_v2
      database-url: "postgresql+psycopg://wizard:generate-a-strong-password@NAME_PLACEHOLDER-db:5432/wizard_v2"

  # Server-side runtime secret for NAME_PLACEHOLDER-web.
  - apiVersion: v1
    kind: Secret
    metadata:
      name: NAME_PLACEHOLDER-web
    type: Opaque
    stringData:
      # Any stable 32-byte base64 string; keep it constant across redeploys.
      # Generate: openssl rand -base64 32
      NEXT_SERVER_ACTIONS_ENCRYPTION_KEY: "generate-with-openssl-rand-base64-32"
      # Dev-login accounts while the stack is built with NEXT_PUBLIC_DEV_AUTH=true:
      # `email:password` pairs, comma-separated. Use fresh passwords, never the
      # local ones in lib/auth.ts. Generate: openssl rand -base64 18
      WIZARD_DEV_USERS: "dev@gaik.local:change-me,dev2@gaik.local:change-me-too"

  # Shared service token (#135). The SAME value is read by the api (validates
  # the X-Wizard-Service-Token header) and the web app (sends it on every
  # server-side call). Every endpoint except /health requires it.
  # Generate: openssl rand -hex 32
  - apiVersion: v1
    kind: Secret
    metadata:
      name: NAME_PLACEHOLDER-token
    type: Opaque
    stringData:
      WIZARD_API_TOKEN: "generate-with-openssl-rand-hex-32"
