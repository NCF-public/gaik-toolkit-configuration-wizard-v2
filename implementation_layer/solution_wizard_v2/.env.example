# Copy to .env.local, which git ignores. Keep real keys out of this file.

# Sign in with the built-in dev accounts instead of Supabase (docs/SECURITY.md).
# Local development only: it is a build-time value, never true in production.
NEXT_PUBLIC_DEV_AUTH=true

# The wizard API. Without it the app runs on mock sessions (UI only), and the
# BPMN diagram is generated by the Python in .venv (scripts/setup.sh).
# WIZARD_API_URL=http://localhost:8100
# WIZARD_API_TOKEN=

# Another Python with pydantic for the mock sessions' BPMN, if not .venv.
# WIZARD_BPMN_PYTHON=

# Supabase sign-in, instead of the dev accounts: set NEXT_PUBLIC_DEV_AUTH=false
# and list who may sign in. Without WIZARD_ALLOWED_EMAILS nobody gets in.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# WIZARD_ALLOWED_EMAILS=
