<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://gaik.solutionwizard/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="Incident and Safety Observation Reporting Assistant" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_users" name="Employee Reporter">
        <bpmn:flowNodeRef>Activity_record_observation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gaik_ai" name="GAIK AI System">
        <bpmn:flowNodeRef>Activity_transcribe_audio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_enhance_transcript</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_extract_report_fields</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_validate_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_submit_incident_reporting_database_optional</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_reviewers" name="Safety Manager">
        <bpmn:flowNodeRef>Activity_human_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_approve_human_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_rejected_human_review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Activity_record_observation" name="Record voice description and optional photo
[User input]">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_2">
        <bpmn:targetRef>DataObjectRef_incident_audio</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Association_3">
        <bpmn:targetRef>DataObjectRef_incident_photo</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_transcribe_audio" name="Transcribe audio recording
[Transcriber]">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:property id="Property_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_5">
        <bpmn:sourceRef>DataObjectRef_incident_audio</bpmn:sourceRef>
        <bpmn:targetRef>Property_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_4">
        <bpmn:targetRef>DataObjectRef_raw_transcript</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_enhance_transcript" name="Enhance Finnish transcript
[TranscriptEnhancer]">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:property id="Property_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_7">
        <bpmn:sourceRef>DataObjectRef_raw_transcript</bpmn:sourceRef>
        <bpmn:targetRef>Property_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_6">
        <bpmn:targetRef>DataObjectRef_enhanced_transcript</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_extract_report_fields" name="Extract incident report fields
[Extractor]">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:property id="Property_3" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_9">
        <bpmn:sourceRef>DataObjectRef_enhanced_transcript</bpmn:sourceRef>
        <bpmn:targetRef>Property_3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_8">
        <bpmn:targetRef>DataObjectRef_incident_report_json</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_validate_report" name="Validate generated report
[LLMJudge]">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:property id="Property_4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_11">
        <bpmn:sourceRef>DataObjectRef_enhanced_transcript</bpmn:sourceRef>
        <bpmn:targetRef>Property_4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_5" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_12">
        <bpmn:sourceRef>DataObjectRef_incident_report_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_5</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_10">
        <bpmn:targetRef>DataObjectRef_validation_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_human_review" name="Safety manager reviews and approves report
[Human review]">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:property id="Property_6" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_14">
        <bpmn:sourceRef>DataObjectRef_incident_report_json</bpmn:sourceRef>
        <bpmn:targetRef>Property_6</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:property id="Property_7" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="Association_15">
        <bpmn:sourceRef>DataObjectRef_validation_report</bpmn:sourceRef>
        <bpmn:targetRef>Property_7</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="Association_13">
        <bpmn:targetRef>DataObjectRef_approved_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_success" name="Process complete">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_approve_human_review" name="Approved?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_rejected_human_review" name="Rejected">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_submit_incident_reporting_database_optional" name="Submit to Incident Reporting Database Optional
[Integration]">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Association_1">
        <bpmn:targetRef>DataStore_incident_reporting_database_optional</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:dataObjectReference id="DataObjectRef_incident_audio" name="incident_audio" dataObjectRef="DataObject_incident_audio" />
    <bpmn:dataObject id="DataObject_incident_audio" />
    <bpmn:dataObjectReference id="DataObjectRef_incident_photo" name="incident_photo" dataObjectRef="DataObject_incident_photo" />
    <bpmn:dataObject id="DataObject_incident_photo" />
    <bpmn:dataObjectReference id="DataObjectRef_raw_transcript" name="raw_transcript" dataObjectRef="DataObject_raw_transcript" />
    <bpmn:dataObject id="DataObject_raw_transcript" />
    <bpmn:dataObjectReference id="DataObjectRef_enhanced_transcript" name="enhanced_transcript" dataObjectRef="DataObject_enhanced_transcript" />
    <bpmn:dataObject id="DataObject_enhanced_transcript" />
    <bpmn:dataObjectReference id="DataObjectRef_incident_report_json" name="incident_report_json" dataObjectRef="DataObject_incident_report_json" />
    <bpmn:dataObject id="DataObject_incident_report_json" />
    <bpmn:dataObjectReference id="DataObjectRef_validation_report" name="validation_report" dataObjectRef="DataObject_validation_report" />
    <bpmn:dataObject id="DataObject_validation_report" />
    <bpmn:dataObjectReference id="DataObjectRef_approved_report" name="approved_report" dataObjectRef="DataObject_approved_report" />
    <bpmn:dataObject id="DataObject_approved_report" />
    <bpmn:dataStoreReference id="DataStore_incident_reporting_database_optional" name="Incident Reporting Database Optional
[Data store]" />
    <bpmn:textAnnotation id="TextAnnotation_1"><bpmn:text>Contains personal data (PII)</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_2"><bpmn:text>Output sensitivity: high</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_3"><bpmn:text>Audit log required</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_record_observation" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_record_observation" targetRef="Activity_transcribe_audio" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_transcribe_audio" targetRef="Activity_enhance_transcript" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_enhance_transcript" targetRef="Activity_extract_report_fields" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_extract_report_fields" targetRef="Activity_validate_report" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_validate_report" targetRef="Activity_human_review" />
    <bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="Gateway_approve_human_review" targetRef="Activity_submit_incident_reporting_database_optional" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_human_review" targetRef="Gateway_approve_human_review" />
    <bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="Gateway_approve_human_review" targetRef="EndEvent_rejected_human_review" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_submit_incident_reporting_database_optional" targetRef="EndEvent_success" />
  </bpmn:process>
