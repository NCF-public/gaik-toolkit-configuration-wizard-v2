{
  "name": "gaik-ui-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:demo": "PLAYWRIGHT_SKIP_WEBSERVER=true PLAYWRIGHT_SLOW_MO=800 playwright test --headed --workers=1",
    "test:docker": "cd ../wizard_api && ./scripts/docker-test.sh",
    "test:all": "npm run test && npm run test:e2e",
    "setup": "npm ci",
    "dev:api": "cd ../wizard_api && ./scripts/dev-api.sh",
    "dev:stack": "cd ../wizard_api && ./scripts/dev-stack.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
    "bpmn-js": "^18.19.0",
    "bpmn-moddle": "^10.1.0",
    "bpmnlint": "^11.12.1",
    "diagram-js-minimap": "^5.3.0",
    "next": "^15.1.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
